# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# API Keys
OPENAI_API_KEY=your-openai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# MCP Server Configuration
# Either provide an SSE endpoint or stdio command to reach your MCP server.
# SSE example:
MCP_SERVER_URL=http://127.0.0.1:9000/sse
# Optional headers for SSE transport as JSON, e.g. {"Authorization": "Bearer token"}
# MCP_SERVER_HEADERS_JSON=
# Optional stdio configuration (e.g. dockerized MCP server)
# MCP_SERVER_COMMAND=docker
# MCP_SERVER_ARGS=run -i --rm -e SEC_EDGAR_USER_AGENT="Jianxing Chen (jc6183@columbia.edu)" sec-edgar-mcp-local:latest
# MCP_SERVER_ENV_JSON={"SEC_EDGAR_USER_AGENT": "Jianxing Chen (jc6183@columbia.edu)"}
# MCP_SERVER_CWD=

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=chrome-extension://your-extension-id,http://localhost:3000

# Rate Limiting
# Format: "requests/period" where period can be 's' (second), 'm' (minute), 'h' (hour), 'd' (day)
# Examples: "100/h" = 100 requests per hour, "10/m" = 10 requests per minute
API_RATE_LIMIT=600/h

# Security Settings (production only)
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True

# Optional: Intel MKL Library Conflict Resolution
# Set this if you encounter Intel MKL library conflicts (usually on certain CPU architectures)
# KMP_DUPLICATE_LIB_OK=TRUE

# Playwright Browser Automation
# NOTE: Playwright requires Chromium to be installed separately via:
#   playwright install chromium
# This is NOT controlled by environment variables. The browser must be installed on the system.
# See Main/backend/PLAYWRIGHT_INTEGRATION.md for installation instructions.
